import Foundation

enum Shape {
    case circle(radius: Double)
    case rectangle(width: Double, height: Double)
    case triangle(base: Double, height: Double)

    var area: Double {
        switch self {
        case .circle(let radius):
            return 3.14 * radius * radius
        case .rectangle(let width, let height):
            return width * height
        case .triangle(let base, let height):
            return 0.5 * base * height
        }
    }
}

struct Rectangle {
    var width: Double
    var height: Double

    var perimeter: Double {
        return 2 * (width + height)
    }

    mutating func scale(by factor: Double) {
        width *= factor
        height *= factor
    }
}

@main
struct ShapesAndAreas {

    static func main() {

        let circle = Shape.circle(radius: 5)
        let rectangleShape = Shape.rectangle(width: 10, height: 5)
        let triangle = Shape.triangle(base: 8, height: 6)

        print("Circle Area:", circle.area)
        print("Rectangle Area:", rectangleShape.area)
        print("Triangle Area:", triangle.area)

        var rect1 = Rectangle(width: 10, height: 5)
        var rect2 = rect1

        rect2.scale(by: 2)

        print("Original Rectangle Width:", rect1.width)
        print("Original Rectangle Height:", rect1.height)
        print("Original Perimeter:", rect1.perimeter)

        print("Copied Rectangle Width:", rect2.width)
        print("Copied Rectangle Height:", rect2.height)
        print("Copied Perimeter:", rect2.perimeter)
    }
}
